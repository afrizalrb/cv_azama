# Dependencies
node_modules/

# Build outputs
/dist/
/build/
/.next/
/.turbo/

# Environment files
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
.tmp/
.temp/


cat > .gitignore << 'EOF'
node_modules/
dist/
.env
.env.local
.env.*.local
.clasp.json
.clasprc.json
*.log
.DS_Store
__pycache__/
*.pyc
data/
EOF
